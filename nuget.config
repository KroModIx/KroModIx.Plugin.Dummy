<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- KroModIx-Pakete (Plugin.Contracts, Plugin.TestKit) aus der eigenen
         Forge in Frankfurt. Seit 27.10.2026; vorher GitHub Packages,
         siehe Lars: »wenn die runners laufen alles nach forgejo umstellen«.

         Zugangsdaten stehen bewusst NICHT hier: Im CI setzt der Workflow
         sie mit `dotnet nuget update source`, lokal gehoeren sie in eine
         nicht eingecheckte nuget.local.config (Muster unten). -->
    <add key="kromodix-forgejo" value="https://git.flexfamily.cloud/api/packages/KroModIx/nuget/index.json" />
  </packageSources>
  <!-- CPM erzwingt Package-Source-Mapping bei mehreren Feeds (NU1507).
       Kroste-Packages nur aus kromodix-forgejo, alles andere aus nuget.org. -->
  <packageSourceMapping>
    <packageSource key="kromodix-forgejo">
      <package pattern="KroModIx.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
<!--
  Lokaler Dev-Feed (optional, nicht committed):
  Um gegen einen noch nicht gepushten Host-Build zu bauen, in einer nicht
  eingecheckten Datei `nuget.local.config` neben dieser hier den Feed
  hinzufügen (dotnet liest beide Configs mergend):

    <?xml version="1.0" encoding="utf-8"?>
    <configuration>
      <packageSources>
        <add key="local-dev" value="/tmp/local-nuget" />
      </packageSources>
      <packageSourceMapping>
        <packageSource key="local-dev">
          <package pattern="KroModIx.*" />
        </packageSource>
      </packageSourceMapping>
    </configuration>

  Und dann:
    dotnet pack .../KroModIx.Plugin.Contracts/KroModIx.Plugin.Contracts.csproj \
      -c Release -o /tmp/local-nuget -p:MinVerVersionOverride=0.2.0-preview
-->
