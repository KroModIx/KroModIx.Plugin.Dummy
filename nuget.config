<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Kroste-GitHub-Packages (KroModIx.Plugin.Contracts).
         Für Read-Access im CI reicht das default GITHUB_TOKEN;
         lokal auf dem Entwickler-Rechner braucht es einen PAT mit
         read:packages, wenn das Package private ist. -->
    <add key="kromodix-github" value="https://nuget.pkg.github.com/KroModIx/index.json" />
  </packageSources>
  <!-- CPM erzwingt Package-Source-Mapping bei mehreren Feeds (NU1507).
       Kroste-Packages nur aus kromodix-github, alles andere aus nuget.org. -->
  <packageSourceMapping>
    <packageSource key="kromodix-github">
      <package pattern="KroModIx.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
<!--
  Lokaler Dev-Feed (optional, nicht committed):
  Um gegen einen noch nicht gepushten Host-Build zu bauen, in einer nicht
  eingecheckten Datei `nuget.local.config` neben dieser hier den Feed
  hinzufügen (dotnet liest beide Configs mergend):

    <?xml version="1.0" encoding="utf-8"?>
    <configuration>
      <packageSources>
        <add key="local-dev" value="/tmp/local-nuget" />
      </packageSources>
      <packageSourceMapping>
        <packageSource key="local-dev">
          <package pattern="KroModIx.*" />
        </packageSource>
      </packageSourceMapping>
    </configuration>

  Und dann:
    dotnet pack .../KroModIx.Plugin.Contracts/KroModIx.Plugin.Contracts.csproj \
      -c Release -o /tmp/local-nuget -p:MinVerVersionOverride=0.2.0-preview
-->
