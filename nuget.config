<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Kroste-GitHub-Packages (Kroste.ModManager.PluginContracts).
         Für Read-Access im CI reicht das default GITHUB_TOKEN;
         lokal auf dem Entwickler-Rechner braucht es einen PAT mit read:packages
         wenn die Package private ist. -->
    <add key="kroste-github" value="https://nuget.pkg.github.com/Kroste/index.json" />
    <!-- Lokaler Dev-Feed für Test gegen noch nicht gepushten Host-Build.
         Wird per `dotnet pack .../ModManager.PluginContracts... -o /tmp/local-nuget` gefüllt.
         Wenn der Ordner fehlt, wird der Feed ignoriert. -->
    <add key="local-dev" value="/tmp/local-nuget" />
  </packageSources>
  <!-- CPM erzwingt Package-Source-Mapping bei mehreren Feeds — sonst NU1507. -->
  <packageSourceMapping>
    <packageSource key="kroste-github">
      <package pattern="Kroste.*" />
    </packageSource>
    <packageSource key="local-dev">
      <package pattern="Kroste.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
